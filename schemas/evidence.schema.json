{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "evidence.schema.json",
  "title": "Evidence Schema",
  "version": "1.0.0",
  "type": "object",
  "required": ["evidence_id", "schema_version", "created_at", "run_id"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "plugin_version": {"type": "string"},
    "evidence_id": {"type": "string"},
    "run_id": {"type": "string"},
    "task_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "evidence_type": {
      "type": "string",
      "enum": ["checkpoint", "metrics", "log", "plot", "config", "command_output", "audit"]
    },
    "path": {"type": "string"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "size_bytes": {"type": "integer"},
    "content_hash": {"type": "string"},
    "linked_metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "value": {"type": ["number", "string"]},
          "source": {"type": "string"}
        }
      }
    },
    "audit": {
      "type": "object",
      "properties": {
        "who": {"type": "string"},
        "why": {"type": "string"}
      }
    }
  }
}
