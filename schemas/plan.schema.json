{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "plan.schema.json",
  "title": "Reproduction Plan Schema",
  "version": "1.0.0",
  "type": "object",
  "required": ["plan_id", "mode", "tasks", "approvals_required", "mandatory_task_ids", "budgets"],
  "properties": {
    "plan_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"},
    "schema_version": {"type": "string", "default": "1.0.0"},
    "plugin_version": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "mode": {"type": "string", "enum": ["strict", "safe", "fast"]},
    "automation": {"type": "string", "enum": ["safe-auto", "auto", "manual"]},
    "tasks": {
      "type": "array",
      "items": {"$ref": "task.schema.json"},
      "minItems": 1
    },
    "approvals_required": {"type": "boolean"},
    "mandatory_task_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "budgets": {
      "type": "object",
      "properties": {
        "max_runtime_min": {"type": "number"},
        "max_retries": {"type": "integer"},
        "gpu_hours": {"type": "number"}
      }
    }
  }
}
