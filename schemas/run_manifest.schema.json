{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "run_manifest.schema.json",
  "title": "Run Manifest Schema",
  "version": "1.0.0",
  "type": "object",
  "required": ["run_id", "plan_id", "schema_version", "started_at"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "plugin_version": {"type": "string"},
    "run_id": {"type": "string"},
    "plan_id": {"type": "string"},
    "project_root": {"type": "string"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "exit_code": {"type": "integer"},
    "status": {"type": "string", "enum": ["running", "completed", "failed", "interrupted"]},
    "environment": {
      "type": "object",
      "properties": {
        "python_version": {"type": "string"},
        "pytorch_version": {"type": "string"},
        "cuda_version": {"type": "string"},
        "gpu_count": {"type": "integer"}
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {"type": "string"},
          "status": {"type": "string"},
          "attempts": {"type": "integer"},
          "exit_code": {"type": "integer"},
          "finished_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
