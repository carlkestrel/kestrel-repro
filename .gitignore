# ============================================
# Project-specific runtime and output
# ============================================

# Reproduction state (DO NOT COMMIT)
.repro/
.execution/
.repair/
.stabilization/

# Audit and reports
audits/
reports/

# Performance — runtime artefacts only (regenerated by runtime-optimizer / hardware-fit-auditor agents).
# These are environment-dependent measurements; do NOT commit as they bind the repo to a specific machine.
# Keep `performance/README.md` and tooling scripts tracked.
performance/*.csv
performance/*.json
performance/*.yaml
performance/*.md
!performance/README.md
!performance/scripts/

# Generated review/PR artefacts live alongside ci_reports/github_review/ and are committed
!ci_reports/
!ci_reports/github_review/
!ci_reports/review_state/
coverage/

# Experiment outputs
runs/
checkpoints/
predictions/
datasets/
soak/

# Malformed filename (created by erroneous shell expansion)
**Audit

# Node (if using any JS tooling)
node_modules/